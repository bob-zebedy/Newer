{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "error.authorization.access-denied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't access folder: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问目录: %@"
          }
        }
      }
