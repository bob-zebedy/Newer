{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "error.authorization.access-denied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't access the authorized folder: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问已授权目录\n%@"
          }
        }
      }
    },
    "error.authorization.invalid" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder access authorization is no longer valid. Grant access again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目录访问授权已失效, 请重新授权"
          }
        }
      }
    },
    "error.authorization.missing" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder access has not been granted. Grant access first."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未授权访问目录, 请先完成授权"
          }
        }
      }
    },
    "error.authorization.outside-scope" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder isn't authorized: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
